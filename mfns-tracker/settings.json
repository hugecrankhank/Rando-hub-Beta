  {
   "title": "Tracker",
   "items": [
    {
     "key": "assumeOldManOnCollect",
     "label": "Assume old man access on item collect",
     "type": "switch",
     "group": "Logic",
     "desc": "When the old man item has been collected, assume logical access to Old Man S&Q spot without placing Old Man rescue caves"
    },
    {
     "key": "includeDungeonItemsInCounter",
     "label": "Always Count Dungeon Items",
     "type": "switch",
     "group": "Display",
     "desc": "Include dungeon items (maps, compasses, small keys, big keys and prizes) in dungeon chest counters even when they stay in their own dungeon. When off, counters only count the checks that hold items shuffled outside of the dungeon."
    }
   ]
  }
